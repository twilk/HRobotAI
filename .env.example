# HRobot control plane — copy to .env and adjust. Values below match docker-compose.yml
# so a fresh clone runs end-to-end with `docker compose up -d`.

# --- Postgres ---------------------------------------------------------------
# Control-plane database (Prisma migrates + reads/writes this one).
CONTROL_PLANE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrobot_control
# Superuser connection used to CREATE per-tenant databases during provisioning.
# Points at the always-present `postgres` maintenance DB on the same instance.
POSTGRES_SUPERUSER_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Tenant DB encryption ---------------------------------------------------
# 32-byte AES-256 key, hex-encoded (exactly 64 hex chars). DEV PLACEHOLDER —
# regenerate for any shared/real env:  openssl rand -hex 32
TENANT_DB_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
# Admin client the provisioning KEYCLOAK_SETUP step authenticates as. The dev
# Keycloak (admin/admin) needs this confidential client created once — see README.
KEYCLOAK_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-only-change-me

# Comma-separated issuer BASES the Python services (agent-service, stt-service) will fetch JWKS
# from. A bearer token whose `iss` is not <one of these>/realms/<realm> is rejected BEFORE any
# network call. Without this, `iss` — an unverified, caller-supplied string — chooses the address
# the signing key is fetched from, which lets an attacker serve their own JWKS and have their own
# forged token confirmed: full auth bypass, any tenant, plus an SSRF to their host. [track J]
#
# Leave UNSET for the default compose setup: it falls back to KEYCLOAK_URL (+ KEYCLOAK_PUBLIC_URL
# when set), which is what the services already talk to.
#
# WHY A LIST AND NOT ONE VALUE: Keycloak stamps `iss` from the realm's frontendUrl, or — when the
# realm has none — from the Host the caller reached it through. In this project both shapes exist
# at once: the seeded demo realm `hrobot-staging` pins frontendUrl=http://keycloak:8080 and always
# issues that, while a control-plane-provisioned realm (e.g. hrobot-4mobility) has no frontendUrl
# and issues http://localhost:8081 for a browser and http://keycloak:8080 for compose-internal
# callers. Verify with:
#   curl -s http://localhost:8081/realms/<realm>/.well-known/openid-configuration | grep issuer
#
# Narrow this to your real issuer(s) in any shared environment; every entry here is a host the
# services may be made to issue an outbound request to.
# KEYCLOAK_TRUSTED_ISSUERS=http://keycloak:8080,https://auth.example.com
#
# Externally-reachable Keycloak base, when it differs from KEYCLOAK_URL. Optional; only used to
# widen the default trusted-issuer list above.
# KEYCLOAK_PUBLIC_URL=http://localhost:8081

# --- Redis / RabbitMQ -------------------------------------------------------
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Secrets (use long random values outside dev) ---------------------------
NEXTAUTH_SECRET=dev-nextauth-secret-change-me-please
# Min 32 chars. Signs the global-admin JWT.
GLOBAL_ADMIN_JWT_SECRET=dev-global-admin-jwt-secret-change-me-please

# --- API --------------------------------------------------------------------
# Optional; apps/api defaults to 3000.
PORT=3000
