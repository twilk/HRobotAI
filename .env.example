# HRobot control plane — copy to .env and adjust. Values below match docker-compose.yml
# so a fresh clone runs end-to-end with `docker compose up -d`.

# ============================================================================
# STAGING / SHARED ENVIRONMENTS — READ THIS FIRST                      [ENV-2]
# ----------------------------------------------------------------------------
# Every credential below is a DEV PLACEHOLDER. docker-compose.yml reads them as
# ${VAR:-default}, so a fresh clone still runs with `docker compose up -d` — but
# anything reachable by another machine MUST override them in its own .env.
#
# Generate real values (never commit them — .env is gitignored):
#   POSTGRES_PASSWORD          openssl rand -base64 24
#   RABBITMQ_PASSWORD          openssl rand -base64 24
#   KEYCLOAK_ADMIN_PASSWORD    openssl rand -base64 24
#   TENANT_DB_ENCRYPTION_KEY   openssl rand -hex 32
#   GLOBAL_ADMIN_JWT_SECRET    openssl rand -base64 48
#   NEXTAUTH_SECRET            openssl rand -base64 48
#
# ORDER OF OPERATIONS: postgres, rabbitmq and keycloak only apply their bootstrap
# credentials on a FIRST boot against an empty volume. Set these BEFORE the first
# `up`, or reset the volumes (`docker compose down -v`, destroys data) / change the
# password in-service afterwards — editing .env alone will not take effect.
# ============================================================================

# --- Postgres ---------------------------------------------------------------
# Consumed by the compose `postgres` service AND interpolated into the two URLs
# below, so changing the password here is enough for the containerized apps.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hrobot_control

# Control-plane database (Prisma migrates + reads/writes this one).
# These two are for HOST-side tooling (prisma CLI, apps run outside compose);
# keep them in sync with POSTGRES_* above. Inside compose the app services build
# their own URLs from POSTGRES_* using service DNS names.
CONTROL_PLANE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrobot_control
# Superuser connection used to CREATE per-tenant databases during provisioning.
# Points at the always-present `postgres` maintenance DB on the same instance.
POSTGRES_SUPERUSER_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Tenant DB encryption ---------------------------------------------------
# 32-byte AES-256 key, hex-encoded (exactly 64 hex chars). DEV PLACEHOLDER —
# regenerate for any shared/real env:  openssl rand -hex 32
TENANT_DB_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
# Bootstrap admin of the compose `keycloak` service. DEV PLACEHOLDER admin/admin —
# override on anything shared; the KC admin console is full control of every realm.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Admin client the provisioning KEYCLOAK_SETUP step authenticates as. This confidential
# client has to be created once in the dev Keycloak — see README.
KEYCLOAK_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-only-change-me

# --- Redis / RabbitMQ -------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Consumed by the compose `rabbitmq` service and interpolated into the app services'
# RABBITMQ_URL. RABBITMQ_URL below is for HOST-side apps; keep the two in sync.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Secrets (use long random values outside dev) ---------------------------
NEXTAUTH_SECRET=dev-nextauth-secret-change-me-please
# Min 32 chars. Signs the global-admin JWT.
GLOBAL_ADMIN_JWT_SECRET=dev-global-admin-jwt-secret-change-me-please

# --- API --------------------------------------------------------------------
# Optional; apps/api defaults to 3000.
PORT=3000
