{
  "name": "@hrobot/web",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable reference app for the HRobot design system (also a portable component kit).",
  "scripts": {
    "dev": "next dev -p 5601",
    "build": "next build",
    "build:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build",
    "start": "next start -p 5601",
    "lint": "eslint app components lib middleware.ts",
    "test": "vitest run",
    "test:e2e:smoke": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@hrobot/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
